# Токен бота из @BotFather: проверка подписи initData и запасная загрузка аватарки.
# Без токена в `next dev` данным Telegram доверяем как есть, на проде вход не работает.
TELEGRAM_BOT_TOKEN=

# Демо-режим проверки подписки: любая почта оплачена, кроме адресов со словом «nopay».
DEMO_MODE=1

# GetCourse: аккаунт (часть адреса до .getcourse.ru) и ключ API — когда DEMO_MODE выключен
GETCOURSE_ACCOUNT=
GETCOURSE_API_KEY=

# Ссылка «Оформить подписку», если оплата не найдена
NEXT_PUBLIC_PAY_URL=
